<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarThumbVertical="@android:color/white"
    android:scrollbarStyle="outsideOverlay"
    android:background="#242424"
    android:fadingEdgeLength="30dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:requiresFadingEdge="vertical">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="60dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginBottom="30dp"
            android:src="@drawable/ic_electro_logo"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="#444444"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="36dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="28sp"
                    android:textColor="#aaaaaa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="@string/settings"
                    android:textAllCaps="false"
                    android:textAlignment="center"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="15dp"
                        android:text="@string/auto_start_description"
                        android:textAllCaps="false"
                        android:textAlignment="center"/>
                    <Button
                        android:id="@+id/setupAutoStartBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/setup_auto_start"
                        style="@style/RoundButtonGrey"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/traffic_monitor_description"
                        android:textAllCaps="false"
                        android:textAlignment="center"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <Button
                            android:id="@+id/disableTrafficMonitorBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/disable_traffic_monitor"
                            android:layout_marginEnd="8dp"
                            style="@style/RoundButtonGrey"/>
                        <Button
                            android:id="@+id/enableTrafficMonitorBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_traffic_monitor"
                            style="@style/RoundButtonGrey"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/dev_tools_description"
                        android:textAllCaps="false"
                        android:textAlignment="center"/>
                    <Button
                        android:id="@+id/openDevToolsBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/open_dev_tools"
                        style="@style/RoundButtonGrey"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="#ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/country_code_description"
                        android:textAllCaps="false"
                        android:textAlignment="center"/>
                    <Button
                        android:id="@+id/openCountryCodeToolBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/open_country_code_tool"
                        style="@style/RoundButtonGrey"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
